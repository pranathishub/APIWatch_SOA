# Copy to .env and replace both placeholders with randomly generated values.
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DB_URL=jdbc:postgresql://localhost:5432/apiwatch
DB_USER=apiwatch
FRONTEND_ORIGIN=http://localhost:5173
# Enable only for trusted local demo endpoints, never an untrusted public deployment.
ALLOW_PRIVATE_TARGETS=false
